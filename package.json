{
  "name": "plotung",
  "version": "0.2.0",
  "description": "Typed tree-reconciliation visualization: describe an upper (species / host) tree and lower (gene / symbiont) trees with their duplication, loss and transfer events, get a layout back, and render it on a zoomable canvas that scales to 100k+ leaves.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./simulate": {
      "types": "./dist/simulate.d.ts",
      "default": "./dist/simulate.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "node --test test/*.test.ts",
    "dev": "npm run build && node scripts/serve.mjs",
    "bundle": "npm run build && node scripts/build-demo.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "phylogenetics",
    "reconciliation",
    "gene-tree",
    "species-tree",
    "cophylogeny",
    "visualization",
    "canvas",
    "infinite-canvas",
    "tree-layout",
    "typescript"
  ],
  "author": "Leon Kim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetweenTwoTests/plotung.git"
  },
  "homepage": "https://github.com/BetweenTwoTests/plotung#readme",
  "bugs": {
    "url": "https://github.com/BetweenTwoTests/plotung/issues"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
